[node name="Hud" type="Node"]
editor_description = "Everything the Player draws on the screen: the on-screen controls, the readouts and bars, the chat and debug panels, the inventory, the abilities, and every menu and screen. Each child's player export points two levels up, at the Player this hangs under."
script = ExtResource("1_hud")

[node name="Controls" parent="." unique_id=1181235604 instance=ExtResource("210_hshj8")]
editor_description = "The on-screen input hints and the button mapping, from the controls addon. Player.controls is this node, and a world prompt names its bottom-action button."

[node name="BossBar" parent="." unique_id=544394449 instance=ExtResource("211_aioe1")]
editor_description = "The name and health of the boss this player is fighting, across the top of the screen. Boss drives it. It is its own scene rather than part of the Controls HUD because a boss's health is a readout of an NPC, not a hint about what a button does; remove it and nothing breaks."
visible = false

[node name="AmmoReadout" parent="." unique_id=1105301214 instance=ExtResource("212_mhr4k")]
editor_description = "The equipped firearm's magazine and reserve, under the crosshair. Firearm drives it, so the count ships with the guns; remove it and nothing breaks."
visible = false

[node name="CastBar" parent="." unique_id=341772415 instance=ExtResource("213_hm2y0")]
editor_description = "The ability being cast and how far through it is, under the crosshair. Abilities drives it; remove it and nothing breaks."

[node name="ThrowChargeBar" parent="." unique_id=453029934 instance=ExtResource("213_throw")]
editor_description = "How far the held object's throw has charged, under the crosshair. HeldObject drives it and hides it; remove it and nothing breaks."
visible = false

[node name="Chat" parent="." unique_id=1421766685 instance=ExtResource("214_2wrkp")]
editor_description = "The text chat window. Copes with no Steamworks autoload, so a project without Steam and a web export still run."
visible = false

[node name="Debug" parent="." unique_id=2032410064 instance=ExtResource("215_xpqqc")]
editor_description = "The debug overlay: state, speed, position and the rest, for a build that wants to see them."
visible = false

[node name="Inventory" parent="." unique_id=509190037 instance=ExtResource("216_aptty")]
editor_description = "The bag and what is worn. Owns items, equipment, the crafting side and the pause menu's pages."

[node name="Abilities" parent="." unique_id=1423797243 instance=ExtResource("217_xwswm")]
editor_description = "The spell and skill set, and the cooldowns behind it."
abilities = Array[ExtResource("218_c4oi1")]([ExtResource("219_lgcvn"), ExtResource("220_p3m8d")])

[node name="SeekerWheel" parent="." unique_id=1372493209 instance=ExtResource("221_8xbw4")]
editor_description = "The second radial menu on the Seeker button: ammunition kinds while aiming, throwables otherwise."

[node name="Pause" parent="." unique_id=498429169 instance=ExtResource("222_n6coi")]
editor_description = "The pause menu and the layer every other menu sits under."
visible = false
inventory_screen_scene = "res://addons/3d_player_controller/inventory/scenes/inventory_screen.tscn"
spells_screen_scene = "res://addons/3d_player_controller/inventory/scenes/spells_screen.tscn"

[node name="Settings" parent="." unique_id=955686872 instance=ExtResource("223_70l8d")]
editor_description = "The settings menu the pause menu opens, and the way through to Audio, Controls and Video."
visible = false

[node name="AudioSettings" parent="." unique_id=1733087110 instance=ExtResource("224_itfik")]
editor_description = "The volume sliders, saved to PlayerSettingsResource on this machine."
visible = false

[node name="ControlsSettings" parent="." unique_id=1813716657 instance=ExtResource("225_ehxtl")]
editor_description = "The on-screen controls mode and the pad layout, saved to PlayerSettingsResource on this machine."
visible = false

[node name="VideoSettings" parent="." unique_id=1733087111 instance=ExtResource("226_dcnid")]
editor_description = "VSync, UI scale, toon shading and the anti-aliasing options, applied through PlayerSettingsResource.apply_video_settings."
visible = false

[node name="LobbyManager" parent="." unique_id=1733087115 instance=ExtResource("227_7355m")]
editor_description = "The Steam lobby: creating one, joining one, and keeping the member list."
visible = false

[node name="Crosshair" type="TextureRect" parent="." unique_id=1819190414]
editor_description = "The aiming reticle, shown while a firearm or bow is up and hidden while the hands are blocked."
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
