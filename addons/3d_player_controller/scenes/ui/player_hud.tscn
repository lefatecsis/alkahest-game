[node name="TargetFrame" parent="." instance=ExtResource("target_frame")]
editor_description = "The Player's Target: its name, its health tinted by disposition, and who it is hunting. Shown while the Player has a Target (Focus.target_changed), hidden otherwise."
visible = false

[node name="UnderwaterOverlay" type="CanvasLayer" parent="." unique_id=556784208]
editor_description = "The full-screen tint while the head is under water; the Swimming state shows and hides it."
layer = -1
visible = false

[node name="ColorRect" type="ColorRect" parent="UnderwaterOverlay" unique_id=1815454061]
material = SubResource("ShaderMaterial_underwater")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="SpyglassOverlay" type="CanvasLayer" parent="."]
editor_description = "The porthole while the Player looks through the Spyglass: the view in a round lens with a brass ring, black beyond it, and the magnification under it. Under the rest of the HUD, so the buttons still show. The Spyglass shows and hides it."
layer = -1
visible = false

