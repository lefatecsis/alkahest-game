texture = SubResource("AtlasTexture_fk680")

[node name="Health" parent="." unique_id=1045609922 instance=ExtResource("229_xc1b5")]
editor_description = "Hit points, damage and death. Its died signal starts the RespawnTimer through the death screen."
max_energy = 100.0

[node name="DeathScreen" parent="." unique_id=31608180 instance=ExtResource("231_eaeif")]
editor_description = "The screen shown on death, counting the RespawnTimer down. Wired to Health.died and Player.respawned."
visible = false

[node name="QuestTracker" parent="." unique_id=1940954794 instance=ExtResource("234_231h3")]
editor_description = "The objectives list in the corner, following the QuestLog."
visible = false

[node name="Stamina" type="TextureProgressBar" parent="." unique_id=1209274681]
