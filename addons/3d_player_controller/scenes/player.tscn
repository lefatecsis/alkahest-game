[node name="Spyglass" parent="PlayerModel/Armature/GeneralSkeleton/SpyglassBoneAttachment" node_paths=PackedStringArray("overlay", "zoom_label", "hand_ik", "hand_rotation", "hand_target", "eyes") instance=ExtResource("spyglass_scene")]
editor_description = "Nina Shaw's spyglass, held in the fist with the fingers up and the palm toward the face, the eyepiece past the thumb, so at the eye the forearm hangs straight down from the wrist. Saved hidden; the Player's scoping_changed is wired to it, so on every peer it comes up to the eye while this Player is scoping (enable_spyglass lets the scope action start it). This peer's own view then goes first person through the Hud's SpyglassOverlay and the spyglass hides."
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 0.07, 0.085, 0.035)
visible = false
overlay = NodePath("../../../../../Hud/SpyglassOverlay")
zoom_label = NodePath("../../../../../Hud/SpyglassOverlay/Zoom")
hand_ik = NodePath("../../SpyglassHandIK")
hand_rotation = NodePath("../../SpyglassHandRotation")
hand_target = NodePath("../../../../../SpyglassHandTarget")
eyes = NodePath("../../FirstPersonCameraBoneAttachment/FirstPersonEyes")

[node name="HeadLookAtModifier3D" type="LookAtModifier3D" parent="PlayerModel/Armature/GeneralSkeleton" index="18" unique_id=1009984629]
editor_description = "Bends the Head alone, and is deliberately the last child of the skeleton so it applies after the spine look-at and the hand IK. 35 degrees either way across, so a target behind the Player is simply not followed, and 45 down and 60 up from the head's rest pose, which already tips it forward: level ahead, the head follows the camera from about 65 degrees below level to 40 above, as far as a neck goes. Driven by Player.set_head_look_at_target: at the camera's HeadLookTarget whenever nothing else claims it, which is how the head looks up and down with the camera, and at a held body or a screen when one does."
active = false
bone_name = "Head"
bone = 6
duration = 0.35
ease_type = 2
use_angle_limitation = true
symmetry_limitation = false
