[node name="FirstPersonRightHand" type="Marker3D" parent="CameraMount/CameraSpringArm/Camera3D" unique_id=285025251]
unique_name_in_owner = true
editor_description = "Where the right hand sits in the view in first person, so the arms and the gun ride the view instead of the torso: RightHandIK reaches for it and FirstPersonRightHandRotation copies its rotation onto the hand. A Firearm places it from its first_person_right_hand export while it is out in first person (a Bow pulls that hand onto its own string instead), so it is left at the camera here."

[node name="FirstPersonLeftHand" type="Marker3D" parent="CameraMount/CameraSpringArm/Camera3D" unique_id=285025252]
unique_name_in_owner = true
editor_description = "The same for the left hand, placed from a Firearm's first_person_left_hand so the support hand keeps the two-handed grip as the view moves, or from a Bow's carry and aim transforms for the bow hand."

