[node name="ShieldGuard" type="Node" parent="." node_paths=PackedStringArray("player")]
editor_description = "Breath of the Wild's shield: Focus held with a shield on the arm raises it (Player.is_guarding, replicated), a hit from in front does no damage, and Action just before it lands parries, throwing the attacker back. The Player's take_hit asks it first."
