[node name="BodyTemperature" type="Node" parent="." node_paths=PackedStringArray("player")]
editor_description = "Breath of the Wild's temperature: below 0 and above 40 degrees the air costs health, fast below -10 and above 50, with any HeatSource (a campfire) warming it. The air is the WeatherFX's where there is one. Off unless Player.enable_temperature; the body wears nothing, so its resistances are 0."
script = ExtResource("body_temperature_gd")
player = NodePath("..")

[node name="SFX_FallScream" type="AudioStreamPlayer3D" parent="."]
