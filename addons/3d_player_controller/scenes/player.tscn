[node name="FirstPersonCameraBoneAttachment" type="BoneAttachment3D" parent="PlayerModel/Armature/GeneralSkeleton" index="2" unique_id=1896825249]
unique_name_in_owner = true
editor_description = "Rides the Head bone. First person puts the camera at its FirstPersonEyes child, so the view moves with the head the animation is giving it and sits where the eyes are rather than at the neck."
bone_name = "Head"
bone_idx = 6

[node name="FirstPersonEyes" type="Marker3D" parent="PlayerModel/Armature/GeneralSkeleton/FirstPersonCameraBoneAttachment" unique_id=1896825250]
unique_name_in_owner = true
editor_description = "Where the eyes are, in the head's own frame: a little above the Head bone and forward to the face, so the first person camera clears the skull instead of being pushed out along the view and into the chest when looking down."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.07, 0.1)

[node name="LookAtModifier3D" type="LookAtModifier3D" parent="PlayerModel/Armature/GeneralSkeleton" index="3" unique_id=703324849]
editor_description = "Pitches the Spine towards CameraMount/ProjectileRaycast/LookAtTarget, so the torso, and the arms with it, follow the aim up and down. Relative to the animation's own pose and about one horizontal axis only, the one square to whichever axis the stance points at the target (the caller says: X for a gun held out in front, Z for the archer's side-on stance): the body already turns to the camera while aiming, so the stance keeps the twist its clip gave it and only the pitch is added. Limited to about 60 degrees either way, and only active while HeldObject, Bow or a Firearm asks for it through Player.set_look_at_target."
active = false
target_node = NodePath("../../../../CameraMount/ProjectileRaycast/LookAtTarget")
bone_name = "Spine"
bone = 2
forward_axis = 4
primary_rotation_axis = 0
use_secondary_rotation = false
relative = true
duration = 0.2
ease_type = 2
use_angle_limitation = true
symmetry_limitation = true
primary_limit_angle = 2.0943952
primary_damp_threshold = 1.0

[node name="ParagliderBoneAttachment" type="BoneAttachment3D" parent="PlayerModel/Armature/GeneralSkeleton" index="4" unique_id=1910251258]
editor_description = "Rides the RightHand bone and carries the paraglider, so the glider hangs off the hand that holds it."
bone_name = "RightHand"
bone_idx = 35

[node name="Paraglider" parent="PlayerModel/Armature/GeneralSkeleton/ParagliderBoneAttachment" unique_id=841772125 instance=ExtResource("paraglider_scene")]
editor_description = "The glider, its contrails and its sounds. Saved hidden; the Player's state_changed is wired to it, so it opens on every peer while this Player is in PARAGLIDING (enable_paraglider turns the state on)."
visible = false

[node name="PhysicalBoneSimulator3D" type="PhysicalBoneSimulator3D" parent="PlayerModel/Armature/GeneralSkeleton" index="5" unique_id=389631199]
editor_description = "The ragdoll. Its PhysicalBone3D children mirror the skeleton and take over on a lethal fall or a knock-down, then hand back when the Player gets up."

