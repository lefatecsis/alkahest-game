[node name="UpdraftDetection" type="Area3D" parent="." unique_id=629577927]
editor_description = "Notices Updraft and Thermal areas the body is in: its area_entered and area_exited are wired to the Player, which is how is_in_updraft knows without scanning the groups. It is on no layer and not monitorable, so nothing else detects it."
collision_layer = 0
monitorable = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="UpdraftDetection" unique_id=729102899]
