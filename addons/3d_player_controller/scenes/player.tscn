editor_description = "Pathfinding for a Player driven by something other than a person: the click-to-move demo and any scripted walk."

[node name="HeadLookTarget" type="Marker3D" parent="."]
editor_description = "What the head looks at when nothing is held: two metres ahead of the head along the way the body faces, raised or lowered by the camera's pitch, so the head looks up and down with the camera in any perspective and never turns sideways. The Camera places it on the Player's own peer; the synchronizer carries its position to everyone else, whose HeadLookAtModifier3D follows it the same way."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 2)

[node name="CameraMount" type="Node3D" parent="." unique_id=1567725441]
editor_description = "The yaw pivot the look input turns. Everything to do with the view hangs off it, so the Player's own model can face somewhere else while the camera does not."
transform = Transform3D(1, 0, 0, 0, 0.96592575, 0.258819, 0, -0.258819, 0.96592575, 0, 2, 0)

[node name="CameraSpringArm" type="SpringArm3D" parent="CameraMount" unique_id=1983020082]
editor_description = "Keeps the third-person camera out of walls by pulling it in when something is between it and the Player. The Player's own body is excluded so it never collides with the character it is following."
spring_length = 2.0

